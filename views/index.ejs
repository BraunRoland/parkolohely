<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Parkolóhely</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="container">
        <div class="row">
            <div class="col-sm-12 text-center">
                <h1>Parkolások</h1>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-12">
                <table class="table table-bordered text-center">
                    <thead>
                        <tr>
                            <th>Rendszám</th>
                            <th>Tulajdonos</th>
                            <th>Időtartam</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% parkolasok.forEach(p => { %>
                            <tr>
                                <td class="<%= !p.fizetve? 'nem-fizetett' : '' %>"><%= p.rendszam %></td>
                                <td class="<%= !p.fizetve? 'nem-fizetett' : '' %>"><%= p.tulajdonos %></td>
                                <td class="<%= !p.fizetve? 'nem-fizetett' : '' %>"><%= p.idotartam %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-10 mx-auto">
                <form method="post" class="form rounded-4">
                    <div class="row">
                        <div class="col-sm-12">
                            <label for="tulajdonos" class="form-label">Tulajdonos: </label>
                            <input type="text" class="form-control" name="tulajdonos">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-6">
                            <label for="rendszam" class="form-label">Rendszám: </label>
                            <input type="text" class="form-control" name="rendszam">
                        </div>
                        <div class="col-sm-6">
                            <label for="idotartam" class="form-label">Időtartam: </label>
                            <input type="number" class="form-control" name="idotartam">
                        </div>
                    </div>
                    <div class="row btnRow">
                        <div class="col-sm-8">
                            <input type="radio" class="form-check-input">
                            <label for="form-check-label">Fizetve</label>
                        </div>
                        <div class="col-sm-4">
                            <button class="btn btn-success" type="submit">Hozzáadás</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
        <% if(locals.p) { %>
            <div class="row">
                <div class="col-sm-12 text-center">
                    <div class="alert alert-<%= errorState? "danger" : "success" %>">
                        <strong><%= errorState? 'Hiba!' : 'Siker!' %></strong> <%= p %>
                    </div>
                </div>
            </div>
        <% } %>
    </div>
</body>
</html>